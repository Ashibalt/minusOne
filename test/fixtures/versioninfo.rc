/* minusOne test fixture: version-information and manifest resources.
 * The VERSIONINFO keyword implies resource type 16; the manifest uses the
 * numeric type 24, keeping windres independent of windows.h. */
1 VERSIONINFO
FILEVERSION 1,2,3,4
PRODUCTVERSION 5,6,7,8
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "MinusOne Labs"
      VALUE "FileDescription", "minusone version-info fixture"
      VALUE "OriginalFilename", "versioninfo-fixture.exe"
      VALUE "ProductName", "minusone-versioninfo"
      VALUE "ProductVersion", "5.6.7.8-rc1"
      VALUE "InternalName", "vfix"
      VALUE "LegalCopyright", "Copyright 2026 MinusOne Labs"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

1 24 "versioninfo.manifest"
